{
  "openapi": "3.1.0",
  "info": {
    "title": "Spanisch-Tutor",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "description": "Der Prozess läuft.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Der Dienst kann Anfragen bearbeiten (Datenbank erreichbar).",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios": {
      "get": {
        "tags": [
          "conversation"
        ],
        "summary": "List Scenarios",
        "operationId": "list_scenarios_api_v1_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioOut"
                  },
                  "type": "array",
                  "title": "Response List Scenarios Api V1 Scenarios Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "conversation"
        ],
        "summary": "Start Session",
        "operationId": "start_session_api_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/sessions/{session_id}/turns": {
      "post": {
        "tags": [
          "conversation"
        ],
        "summary": "Take Turn",
        "operationId": "take_turn_api_v1_sessions__session_id__turns_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/end": {
      "post": {
        "tags": [
          "conversation"
        ],
        "summary": "End Session",
        "operationId": "end_session_api_v1_sessions__session_id__end_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/messages/{message_id}/translation": {
      "post": {
        "tags": [
          "conversation"
        ],
        "summary": "Translate Message",
        "description": "Übersetzt einen Beitrag der Gegenseite ins Deutsche. Ein zweiter Abruf kostet nichts.",
        "operationId": "translate_message_api_v1_sessions__session_id__messages__message_id__translation_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Message Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Get Profile",
        "operationId": "get_profile_api_v1_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "profile"
        ],
        "summary": "Update Profile",
        "operationId": "update_profile_api_v1_profile_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryCountOut": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ErrorCategory"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "category",
          "count"
        ],
        "title": "CategoryCountOut"
      },
      "CefrLevel": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ],
        "title": "CefrLevel",
        "description": "Sprachniveau nach dem Gemeinsamen Europäischen Referenzrahmen."
      },
      "CorrectionOut": {
        "properties": {
          "original": {
            "type": "string",
            "title": "Original"
          },
          "corrected": {
            "type": "string",
            "title": "Corrected"
          },
          "category": {
            "$ref": "#/components/schemas/ErrorCategory"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "original",
          "corrected",
          "category",
          "explanation"
        ],
        "title": "CorrectionOut"
      },
      "ErrorCategory": {
        "type": "string",
        "enum": [
          "presente",
          "preterito_indefinido",
          "preterito_imperfecto",
          "preterito_perfecto",
          "futuro",
          "condicional",
          "subjuntivo",
          "imperativo",
          "ser_estar",
          "articulos_genero",
          "concordancia",
          "preposiciones",
          "pronombres",
          "orden_palabras",
          "vocabulario",
          "ortografia",
          "otro"
        ],
        "title": "ErrorCategory",
        "description": "Fehlerkategorien. Die Werte dienen als stabile Schlüssel für Statistiken."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeywordOut": {
        "properties": {
          "spanish": {
            "type": "string",
            "title": "Spanish"
          },
          "german": {
            "type": "string",
            "title": "German"
          }
        },
        "type": "object",
        "required": [
          "spanish",
          "german"
        ],
        "title": "KeywordOut"
      },
      "ProfileOut": {
        "properties": {
          "cefr_level": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "explanation_language": {
            "type": "string",
            "title": "Explanation Language"
          }
        },
        "type": "object",
        "required": [
          "cefr_level",
          "explanation_language"
        ],
        "title": "ProfileOut"
      },
      "ProfileUpdate": {
        "properties": {
          "cefr_level": {
            "$ref": "#/components/schemas/CefrLevel"
          }
        },
        "type": "object",
        "required": [
          "cefr_level"
        ],
        "title": "ProfileUpdate"
      },
      "ScenarioOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "title": "ScenarioOut"
      },
      "StartSessionRequest": {
        "properties": {
          "scenario": {
            "type": "string",
            "title": "Scenario",
            "default": "frei"
          },
          "cefr_level": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CefrLevel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "StartSessionRequest"
      },
      "StartSessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "scenario": {
            "$ref": "#/components/schemas/ScenarioOut"
          },
          "cefr_level": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "opening": {
            "type": "string",
            "title": "Opening"
          },
          "opening_message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Opening Message Id"
          },
          "max_turns": {
            "type": "integer",
            "title": "Max Turns"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "scenario",
          "cefr_level",
          "opening",
          "opening_message_id",
          "max_turns"
        ],
        "title": "StartSessionResponse"
      },
      "SummaryResponse": {
        "properties": {
          "turns": {
            "type": "integer",
            "title": "Turns"
          },
          "corrections": {
            "items": {
              "$ref": "#/components/schemas/CorrectionOut"
            },
            "type": "array",
            "title": "Corrections"
          },
          "by_category": {
            "items": {
              "$ref": "#/components/schemas/CategoryCountOut"
            },
            "type": "array",
            "title": "By Category"
          }
        },
        "type": "object",
        "required": [
          "turns",
          "corrections",
          "by_category"
        ],
        "title": "SummaryResponse"
      },
      "TranslationResponse": {
        "properties": {
          "translation": {
            "type": "string",
            "title": "Translation"
          },
          "keywords": {
            "items": {
              "$ref": "#/components/schemas/KeywordOut"
            },
            "type": "array",
            "title": "Keywords"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          }
        },
        "type": "object",
        "required": [
          "translation",
          "keywords",
          "cached"
        ],
        "title": "TranslationResponse"
      },
      "TurnRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TurnRequest"
      },
      "TurnResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "reply_message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reply Message Id"
          },
          "corrections": {
            "items": {
              "$ref": "#/components/schemas/CorrectionOut"
            },
            "type": "array",
            "title": "Corrections"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "reply_message_id",
          "corrections"
        ],
        "title": "TurnResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
