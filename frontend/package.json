{
  "name": "spanisch-tutor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "//": "overrides: openapi-typescript verlangt TypeScript 5, funktioniert nachweislich mit 6 (npm run api:types). TypeScript 7 (nativer Compiler) bricht das Werkzeug."
}
